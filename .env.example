# Variables de entorno de Supabase (rellena los valores en .env.local, nunca en el repo)

# URL del proyecto: Supabase -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Clave publica (publishable key), segura para el navegador. La proteccion de datos depende de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# UUID de la única cuenta administradora de Supabase Auth (solo servidor).
# Si está vacío o no es un UUID, el acceso administrativo queda denegado.
ADMIN_USER_ID=

# Origen público codificado dentro de los QR. En desarrollo puede ser
# http://localhost:3000 o una URL accesible desde el teléfono. En producción
# debe ser HTTPS y no puede apuntar a localhost ni a una dirección privada.
# QR_PUBLIC_BASE_URL=http://localhost:3000
QR_PUBLIC_BASE_URL=
